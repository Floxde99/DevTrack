{
  "manifest_version": 3,
  "name": "DevTrack Context Bridge",
  "version": "0.1.0",
  "description": "Opt-in browser context capture (domain by default) for DevTrack.",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DevTrack Context Bridge"
  }
}

